# All keys are OPTIONAL. AirIQ runs fully on Open-Meteo (no key) without them.
# Copy to .env.local and fill in any you have. Keys are only read server-side
# (inside app/api route handlers) and never sent to the browser.

# Ground-station markers on /map. Priority: WAQI first, then OpenAQ.
# With neither set, the map shows "Ground stations: not configured".

# WAQI / aqicn.org. Free token: https://aqicn.org/data-platform/token/
WAQI_TOKEN=

# OpenAQ v3. Free key: https://explore.openaq.org/register
OPENAQ_API_KEY=

# Google Gemini for the AI assistant. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=
